<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/paper">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            style="@style/Brand"
            android:text="@string/brand" />

        <TextView
            style="@style/Title"
            android:text="@string/form_title" />

        <TextView
            style="@style/Body"
            android:text="@string/form_copy" />

        <TextView
            style="@style/Label"
            android:text="@string/name"
            android:labelFor="@+id/nombre" />

        <EditText
            style="@style/Field"
            android:id="@+id/nombre"
            android:inputType="textPersonName" android:hint="@string/name_hint" android:maxLength="80" />

        <TextView
            style="@style/Label"
            android:text="@string/email"
            android:labelFor="@+id/correo" />

        <EditText
            style="@style/Field"
            android:id="@+id/correo"
            android:inputType="textEmailAddress" android:hint="@string/email_hint" android:maxLength="254" />

        <TextView
            style="@style/Label"
            android:text="@string/point" />

        <RadioGroup
            android:id="@+id/punto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton android:id="@+id/local" style="@style/Field" android:text="@string/local" />
            <RadioButton android:id="@+id/carrito" style="@style/Field" android:text="@string/cart" />
        </RadioGroup>

        <CheckBox
            style="@style/Field"
            android:text="@string/acid"
            android:id="@+id/acida" />

        <Button
            style="@style/Action"
            android:text="@string/confirm"
            android:id="@+id/confirmar" />
    </LinearLayout>
</ScrollView>
